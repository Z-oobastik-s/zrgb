# Firebase (visitor counter) — copy to .env.local and fill from Firebase Console
# Project: zgbminecraft → Project settings → Your apps → Web app

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zgbminecraft.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=zgbminecraft
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=zgbminecraft.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
